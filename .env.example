# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Postgres (used by docker-compose.yml and the app)
POSTGRES_USER=study
POSTGRES_PASSWORD=
POSTGRES_DB=study
DATABASE_URL=postgres://study:<password>@localhost:5432/study

# Gemini (get a key at https://aistudio.google.com)
GEMINI_API_KEY=
# Run `npm run check:gemini` to see which model names your key can use
GEMINI_CHAT_MODEL=
GEMINI_EMBED_MODEL=

# Better Auth. Generate a secret with: npx auth secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# Chunks further than this cosine distance from a question are ignored (default 0.45).
# RETRIEVAL_MAX_DISTANCE=0.45
